<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>FSharp.Wasm.Sdk</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="ProjectConfig.fs" />
    <Compile Include="PurityAnalysis.fs" />
    <Compile Include="SplitAnalysis.fs" />
    <Compile Include="FieldMapGenerator.fs" />
    <Compile Include="WitGenerator.fs" />
    <Compile Include="BuildPipeline.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../FSharp.Wasm.Protocol/FSharp.Wasm.Protocol.fsproj" />
    <ProjectReference Include="../FSharp.Wasm.Host/FSharp.Wasm.Host.fsproj" />
  </ItemGroup>

</Project>
